{
  "name": "pocketlab-museum",
  "version": "0.1.0",
  "private": true,
  "description": "The Pocket Museum — every machine PocketJS runs on, with hardware specs and the upstream bring-up docs.",
  "homepage": "https://museum.pocketlab.build",
  "type": "module",
  "scripts": {
    "og:generate": "bun scripts/generate-og.ts",
    "dev": "bun run og:generate && vite",
    "build": "bun run og:generate && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run build",
    "upstream:update": "git submodule update --remote --depth 1 external/pocketjs && git add external/pocketjs",
    "upstream:init": "git submodule update --init --depth 1 external/pocketjs"
  },
  "dependencies": {
    "@unhead/vue": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/langs": "^4.0.0",
    "@shikijs/themes": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.0.0",
    "markdown-it-container": "^4.0.0",
    "shiki": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
